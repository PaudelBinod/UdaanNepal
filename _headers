/*
  # Prevent clickjacking
  X-Frame-Options: DENY
  # Prevent MIME-type sniffing
  X-Content-Type-Options: nosniff
  # Force HTTPS for 1 year
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # Control referrer info sent to other sites
  Referrer-Policy: strict-origin-when-cross-origin
  # Disable browser features not used by this site
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # Content Security Policy
  # - default-src: block everything not explicitly listed
  # - script-src: only our own scripts + Supabase JS CDN + jsdelivr
  # - style-src: our styles + Google Fonts
  # - font-src: Google Fonts
  # - img-src: our domain + Supabase storage + data URIs (for thumbnails)
  # - connect-src: Supabase API only
  # - frame-ancestors: nobody can embed us in an iframe
